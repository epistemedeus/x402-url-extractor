{
  "schema": "s137.consumer-jobs.real-migration-observations.v1",
  "jobId": "R2-CONSUMER-JOBS-01",
  "caseId": "x402-spec-v1-to-v2-http",
  "evidenceClass": "fixture",
  "clock": "2026-09-10T11:24:43Z",
  "decision": "partial",
  "note": "Observations quote or locate captured text only. Parallel wording is not treated as a stated rename.",
  "findings": [
    {
      "id": "pos-http-402",
      "kind": "positive",
      "citationIds": ["cite-old-http-402-status", "cite-new-http-402-status"],
      "text": "Both HTTP transports say the server indicates payment is required using the HTTP 402 \"Payment Required\" status code."
    },
    {
      "id": "pos-post-verify",
      "kind": "positive",
      "citationIds": ["cite-old-spec-verify", "cite-new-spec-verify"],
      "text": "Both core specs include a heading \"7.1 POST /verify\"."
    },
    {
      "id": "pos-post-settle",
      "kind": "positive",
      "citationIds": ["cite-old-spec-settle", "cite-new-spec-settle"],
      "text": "Both core specs include a heading \"7.2 POST /settle\"."
    },
    {
      "id": "pos-get-supported",
      "kind": "positive",
      "citationIds": ["cite-old-spec-supported", "cite-new-spec-supported"],
      "text": "Both core specs include a heading \"7.3 GET /supported\"."
    },
    {
      "id": "pos-discovery-resources",
      "kind": "positive",
      "citationIds": ["cite-old-spec-discovery", "cite-new-spec-discovery"],
      "text": "Both core specs include \"8.1 GET /discovery/resources\"."
    },
    {
      "id": "neg-outputSchema",
      "kind": "negative",
      "citationIds": ["cite-old-spec-outputSchema", "cite-new-spec-accepts-table"],
      "text": "v1 PaymentRequirements table lists optional `outputSchema`. The v2 accepts-field table in section 5.1.2 does not list `outputSchema`. Captured v2 text does not state a replacement field."
    },
    {
      "id": "neg-x-payment-header",
      "kind": "negative",
      "citationIds": ["cite-old-http-x-payment", "cite-new-http-header-summary"],
      "text": "v1 HTTP transport names client payment header `X-PAYMENT`. v2 HTTP header summary lists `PAYMENT-REQUIRED`, `PAYMENT-SIGNATURE`, and `PAYMENT-RESPONSE` and does not mention `X-PAYMENT`. No captured document states that one name replaces the other."
    },
    {
      "id": "neg-maxAmountRequired",
      "kind": "negative",
      "citationIds": ["cite-old-spec-maxAmountRequired", "cite-new-spec-amount"],
      "text": "v1 lists required `maxAmountRequired`. v2 lists required `amount`. v2 version history says \"restructured PaymentPayload/Required\" without naming `maxAmountRequired`. Mapping those two field names is unknown on these captures."
    },
    {
      "id": "neg-discovered-metadata",
      "kind": "negative",
      "citationIds": ["cite-old-spec-discovered-metadata", "cite-new-spec-discovered-fields"],
      "text": "v1 discovered-resource table includes optional `metadata`. v2 discovered-resource table includes optional `extensions` and does not list `metadata`."
    },
    {
      "id": "partial-schemes-dir",
      "kind": "partial",
      "citationIds": ["cite-new-spec-schemes-dir"],
      "text": "v2 says individual schemes including exact, upto, batch-settlement, and auth-capture are specified under specs/schemes/. Those files are not in this fixture."
    },
    {
      "id": "partial-discovery-search",
      "kind": "partial",
      "citationIds": ["cite-new-spec-discovery-search"],
      "text": "v2 section 8.2 GET /discovery/search says search semantics live in specs/extensions/bazaar.md. That file is not in this fixture. v1 has no GET /discovery/search heading."
    },
    {
      "id": "partial-version-history",
      "kind": "partial",
      "citationIds": ["cite-new-spec-version-history"],
      "text": "v2 version history row v2.0 dated 2025-12-9 states \"Protocol v2: CAIP-2 networks, restructured PaymentPayload/Required, ResourceInfo separation, extensions support\". That is the only captured migration summary. It does not enumerate header or field renames."
    },
    {
      "id": "conflict-v1-payment-required-location",
      "kind": "conflict",
      "citationIds": ["cite-old-spec-x-payment-error", "cite-old-http-402-body"],
      "text": "v1 core spec example PaymentRequirementsResponse.error is the string \"X-PAYMENT header is required\". v1 HTTP transport Payment Required Signaling uses a JSON response body (PaymentRequirementsResponse schema in response body) and does not define a payment-required header."
    },
    {
      "id": "conflict-lastUpdated-type",
      "kind": "conflict",
      "citationIds": ["cite-old-spec-lastUpdated", "cite-new-spec-lastUpdated"],
      "text": "Same field name `lastUpdated` is a Unix timestamp number (required) in v1 section 8.2 and an ISO 8601 timestamp string (required) in v2 section 8.3. Neither document maps the two representations."
    },
    {
      "id": "conflict-payer-required",
      "kind": "conflict",
      "citationIds": ["cite-old-spec-payer-required", "cite-new-spec-payer-optional"],
      "text": "v1 SettlementResponse table marks `payer` Required. v2 SettleResponse table marks `payer` Optional."
    },
    {
      "id": "conflict-error-value-token",
      "kind": "conflict",
      "citationIds": ["cite-old-spec-error-value", "cite-new-spec-error-value-mismatch"],
      "text": "v1 error list includes `invalid_exact_evm_payload_authorization_value` (\"Payment amount is insufficient for the required payment\"). v2 error list includes `invalid_exact_evm_payload_authorization_value_mismatch` (\"Payment amount does not exactly match the required amount\") and does not list the v1 token. No captured mapping between the tokens."
    }
  ],
