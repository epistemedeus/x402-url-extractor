{
  "name": "c24-monorepo-npm-rewritten",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "c24-monorepo-npm-rewritten",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "@c24/web",
      "version": "1.0.0",
      "dependencies": {
        "shared-kit": "^2.1.0"
      }
    },
    "packages/shared-kit": {
      "name": "shared-kit",
      "version": "0.4.0"
    },
    "node_modules/shared-kit": {
      "resolved": "packages/shared-kit",
      "link": true
    },
    "apps/web/node_modules/shared-kit": {
      "resolved": "packages/shared-kit",
      "link": true
    }
  }
}
