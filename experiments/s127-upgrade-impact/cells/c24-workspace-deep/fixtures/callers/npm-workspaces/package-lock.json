{
  "name": "c24-monorepo-npm",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "c24-monorepo-npm",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "@c24/web",
      "version": "1.0.0",
      "dependencies": {
        "shared-kit": "workspace:*"
      }
    },
    "apps/web-unused": {
      "name": "@c24/web-unused",
      "version": "1.0.0",
      "dependencies": {
        "shared-kit": "workspace:*"
      }
    },
    "packages/shared-kit": {
      "name": "shared-kit",
      "version": "0.4.0",
      "dependencies": {
        "shared-kit-core": "workspace:*"
      }
    },
    "packages/shared-kit-core": {
      "name": "shared-kit-core",
      "version": "0.1.0"
    },
    "node_modules/shared-kit": {
      "resolved": "packages/shared-kit",
      "link": true
    },
    "node_modules/shared-kit-core": {
      "resolved": "packages/shared-kit-core",
      "link": true
    },
    "apps/web/node_modules/shared-kit": {
      "resolved": "packages/shared-kit",
      "link": true
    },
    "apps/web-unused/node_modules/shared-kit": {
      "resolved": "packages/shared-kit",
      "link": true
    },
    "packages/shared-kit/node_modules/shared-kit-core": {
      "resolved": "packages/shared-kit-core",
      "link": true
    }
  }
}
