    "postinstall": "node -e \"require('fs').writeFileSync('SENTINEL_SHOULD_NOT_EXIST','executed')\"",
    "prepare": "node -e \"require('fs').writeFileSync('SENTINEL_SHOULD_NOT_EXIST','executed')\""
  }
}
