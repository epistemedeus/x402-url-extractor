{
  "name": "c02-workspace-root",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "c02-workspace-root",
      "version": "0.0.0",
      "workspaces": ["packages/*"],
      "dependencies": {
        "@acme/lib": "workspace:*"
      }
    },
    "packages/lib": {
      "name": "@acme/lib",
      "version": "1.2.3"
    },
    "node_modules/@acme/lib": {
      "resolved": "packages/lib",
      "link": true
    }
  }
}
