 if (!base || !grant) {
   process.stderr.write("grant_required\n");
   process.exit(2);
+}
+
+// Optional caller contract. Recovery stays in the caller's receipt document.
+// Existing grant authority and service writers are unchanged.
+if (process.env.USEFUL_RESULT_DELIVERY_CONTRACT || process.env.USEFUL_RESULT_DELIVERY_RECEIPT) {
+  try {
+    if (!process.env.USEFUL_RESULT_DELIVERY_CONTRACT || !process.env.USEFUL_RESULT_DELIVERY_RECEIPT
+      || process.env.USEFUL_RESULT_ACTION || process.env.USEFUL_RESULT_QUERY
