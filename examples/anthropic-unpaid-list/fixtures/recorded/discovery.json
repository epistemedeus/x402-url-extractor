{
  "openapi": {
    "status": 200,
    "body": {
      "info": {
        "title": "SameDayDesk machine commerce gateway",
        "version": "1.23.49"
      },
      "paths": {
        "/extract": {
          "get": { "operationId": "extract" }
        },
        "/extract/batch": {
          "post": { "operationId": "extractBatch" }
        }
      }
    }
  },
  "wellKnown": {
    "status": 200,
    "body": {
      "x402Version": 2,
      "items": [
        {
          "resource": {
            "url": "https://agents.samedaydesk.com/extract?url=https%3A%2F%2Fexample.com",
            "routeTemplate": "/extract"
          },
          "request": { "method": "GET" },
          "accepts": [
            {
              "scheme": "exact",
              "network": "eip155:8453",
              "amount": "5000"
            }
          ]
        },
        {
          "resource": {
            "url": "https://agents.samedaydesk.com/extract/batch",
            "routeTemplate": "/extract/batch"
          },
          "request": { "method": "POST" },
          "accepts": [
            {
              "scheme": "exact",
              "network": "eip155:8453",
              "amount": "10000"
            }
          ]
        }
      ]
    }
  },
  "actions": {
    "status": 200,
    "body": {
      "actions": [
        {
          "name": "extract",
          "method": "GET",
          "route": "/extract",
          "priceAtomicUsdc": "5000"
        },
        {
          "name": "extract_batch",
          "method": "POST",
          "route": "/extract/batch",
          "priceAtomicUsdc": "10000"
        }
      ]
    }
  },
  "mcpInitialize": {
    "status": 200,
    "sse": true,
    "body": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
        "protocolVersion": "2025-11-25",
        "capabilities": { "tools": { "listChanged": true } },
        "serverInfo": {
          "name": "x402-data-gateway",
          "version": "1.23.49"
        }
      }
    }
  },
  "mcpToolsList": {
    "status": 200,
    "sse": true,
    "body": {
      "jsonrpc": "2.0",
      "id": 2,
      "result": {
        "tools": [
          { "name": "extract" },
          { "name": "extract_batch" },
          { "name": "read" }
        ]
      }
    }
  },
  "extract402": {
    "status": 402,
    "body": {
      "x402Version": 2,
      "error": "Payment required",
      "resource": {
        "url": "https://agents.samedaydesk.com/extract?url=https%3A%2F%2Fexample.com"
      },
      "accepts": [
        {
          "scheme": "exact",
          "network": "eip155:8453",
          "amount": "5000",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "payTo": "0x8904dF3DE6DFEe6a7C8cc38619d2f17806213Cee"
        }
      ]
    }
  },
  "extractBatch402": {
    "status": 402,
    "body": {
      "x402Version": 2,
      "error": "Payment required",
      "resource": {
        "url": "https://agents.samedaydesk.com/extract/batch"
      },
      "accepts": [
        {
          "scheme": "exact",
          "network": "eip155:8453",
          "amount": "10000",
          "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
          "payTo": "0x8904dF3DE6DFEe6a7C8cc38619d2f17806213Cee"
        }
