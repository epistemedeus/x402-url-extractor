        },
        {
          "argv": [
            "node",
            "package/bin/seller-repair.mjs",
            "reproduce",
            "--case",
            "package/cases/retained-case.json"
          ],
          "stdoutIncludes": [
            "\"loopbackFix\":true",
            "\"deployedCounterpartyRepair\":false",
            "\"paymentSent\":false",
            "\"scanner\":\"not_bundled\"",
