          ],
          "stdoutIncludes": [
            "\"state\": \"unlaunched\"",
            "\"claimAuthority\": \"none\"",
            "\"paymentAuthority\": \"none\""
          ]
        }
      ]
    },
    {
      "id": "seller-repair-external-consumer",
