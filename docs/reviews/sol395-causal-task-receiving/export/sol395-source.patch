index 0000000..dbe3b52
--- /dev/null
+++ b/docs/reviews/sol395-causal-task-receiving/receiving.test.mjs
@@ -0,0 +1,175 @@
+import assert from 'node:assert/strict';
+import { fork, spawnSync } from 'node:child_process';
