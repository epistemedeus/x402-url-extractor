{
  "schemaVersion": "samedaydesk.mcp-typed-telemetry-fixtures.v1",
  "baseInput": {
    "schemaVersion": "samedaydesk.mcp-typed-telemetry-input.v1",
    "binding": {
      "tool": "enrich",
      "productSku": "samedaydesk-enrich",
      "resource": "mcp://tool/enrich",
      "issuedOfferDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "request": {
      "jsonrpc": "2.0",
      "hasId": true,
      "id": 7,
      "method": "tools/call"
    },
    "response": {
      "hasId": true,
      "id": 7,
      "kind": "tool_result"
    },
    "credential": {
      "state": "verified",
      "offerDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "execution": {
      "state": "handler_success",
      "handlerInvoked": true,
      "resultIsError": false
    },
    "settlement": {
      "state": "succeeded",
      "offerDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  },
  "cases": [
    {
      "id": "verified_handler_and_settlement_success",
      "mutations": [],
      "expected": { "action": "emit", "result": "paid_success", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": true, "applicationOutcome": "success", "settlementState": "succeeded", "reason": "typed_paid_success" }
    },
    {
      "id": "handler_error_never_paid_success",
      "mutations": [
        { "op": "set", "path": "execution.state", "value": "handler_error" },
        { "op": "set", "path": "execution.resultIsError", "value": true },
        { "op": "set", "path": "settlement.state", "value": "not_attempted" },
        { "op": "set", "path": "settlement.offerDigest", "value": null }
      ],
      "expected": { "action": "emit", "result": "application_failure", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": true, "applicationOutcome": "error", "settlementState": "not_attempted", "reason": "typed_application_failure" }
    },
    {
      "id": "contradictory_handler_success_and_iserror_is_invalid",
      "mutations": [{ "op": "set", "path": "execution.resultIsError", "value": true }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_typed_outcome" }
    },
    {
      "id": "notification_is_protocol_only",
      "mutations": [
        { "op": "set", "path": "request.hasId", "value": false },
        { "op": "set", "path": "request.id", "value": null },
        { "op": "set", "path": "response.hasId", "value": false },
        { "op": "set", "path": "response.id", "value": null },
        { "op": "set", "path": "response.kind", "value": "no_response" },
        { "op": "set", "path": "credential.state", "value": "absent" },
        { "op": "set", "path": "credential.offerDigest", "value": null },
        { "op": "set", "path": "execution.state", "value": "not_invoked" },
        { "op": "set", "path": "execution.handlerInvoked", "value": false },
        { "op": "set", "path": "execution.resultIsError", "value": null },
        { "op": "set", "path": "settlement.state", "value": "not_attempted" },
        { "op": "set", "path": "settlement.offerDigest", "value": null }
      ],
      "expected": { "action": "emit", "result": "protocol_discovery", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "jsonrpc_notification" }
    },
    {
      "id": "notification_with_forged_paid_state_is_invalid",
      "mutations": [
        { "op": "set", "path": "request.hasId", "value": false },
        { "op": "set", "path": "request.id", "value": null },
        { "op": "set", "path": "response.hasId", "value": false },
        { "op": "set", "path": "response.id", "value": null },
        { "op": "set", "path": "response.kind", "value": "no_response" }
      ],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_notification_state" }
    },
    {
      "id": "response_id_type_mismatch_drops",
      "mutations": [{ "op": "set", "path": "response.id", "value": "7" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "request_response_id_mismatch" }
    },
    {
      "id": "response_id_absent_drops",
      "mutations": [
        { "op": "set", "path": "response.hasId", "value": false },
        { "op": "set", "path": "response.id", "value": null }
      ],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "request_response_id_mismatch" }
    },
    {
      "id": "tool_name_mismatch_drops",
      "mutations": [{ "op": "set", "path": "binding.tool", "value": "read" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_catalog_binding" }
    },
    {
      "id": "tool_sku_mismatch_drops",
      "mutations": [{ "op": "set", "path": "binding.productSku", "value": "samedaydesk-read" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_catalog_binding" }
    },
    {
      "id": "tool_resource_mismatch_drops",
      "mutations": [{ "op": "set", "path": "binding.resource", "value": "mcp://tool/read" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_catalog_binding" }
    },
    {
      "id": "malformed_issued_offer_digest_drops",
      "mutations": [{ "op": "set", "path": "binding.issuedOfferDigest", "value": "abc" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_catalog_binding" }
    },
    {
      "id": "rejected_credential_is_challenge",
      "mutations": [
        { "op": "set", "path": "response.kind", "value": "payment_required" },
        { "op": "set", "path": "credential.state", "value": "rejected" },
        { "op": "set", "path": "credential.offerDigest", "value": null },
        { "op": "set", "path": "execution.state", "value": "not_invoked" },
        { "op": "set", "path": "execution.handlerInvoked", "value": false },
        { "op": "set", "path": "execution.resultIsError", "value": null },
        { "op": "set", "path": "settlement.state", "value": "not_attempted" },
        { "op": "set", "path": "settlement.offerDigest", "value": null }
      ],
      "expected": { "action": "emit", "result": "challenge", "paymentPresent": true, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "typed_payment_required" }
    },
    {
      "id": "verified_credential_offer_mismatch_drops",
      "mutations": [{ "op": "set", "path": "credential.offerDigest", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "issued_offer_binding_mismatch" }
    },
    {
      "id": "settlement_offer_mismatch_drops",
      "mutations": [{ "op": "set", "path": "settlement.offerDigest", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "issued_offer_binding_mismatch" }
    },
    {
      "id": "handler_success_settlement_failure",
      "mutations": [{ "op": "set", "path": "settlement.state", "value": "failed" }],
      "expected": { "action": "emit", "result": "settlement_failure", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": true, "applicationOutcome": "success", "settlementState": "failed", "reason": "typed_settlement_failure" }
    },
    {
      "id": "handler_success_unknown_settlement_never_success",
      "mutations": [
        { "op": "set", "path": "settlement.state", "value": "unknown" },
        { "op": "set", "path": "settlement.offerDigest", "value": null }
      ],
      "expected": { "action": "emit", "result": "telemetry_incomplete", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": true, "applicationOutcome": "success", "settlementState": "unknown", "reason": "settlement_outcome_unknown" }
    },
    {
      "id": "verified_settled_replay_is_separate",
      "mutations": [
        { "op": "set", "path": "execution.state", "value": "replay_success" },
        { "op": "set", "path": "execution.handlerInvoked", "value": false }
      ],
      "expected": { "action": "emit", "result": "replay_success", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": false, "applicationOutcome": "replay", "settlementState": "succeeded", "reason": "typed_replay_success" }
    },
    {
      "id": "verified_without_execution_is_incomplete",
      "mutations": [
        { "op": "set", "path": "execution.state", "value": "not_invoked" },
        { "op": "set", "path": "execution.handlerInvoked", "value": false },
        { "op": "set", "path": "execution.resultIsError", "value": null },
        { "op": "set", "path": "settlement.state", "value": "not_attempted" },
        { "op": "set", "path": "settlement.offerDigest", "value": null }
      ],
      "expected": { "action": "emit", "result": "telemetry_incomplete", "paymentPresent": true, "paymentCredentialParsed": true, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "verified_without_execution" }
    },
    {
      "id": "unsafe_integer_request_id_drops",
      "mutations": [
        { "op": "set", "path": "request.id", "value": 9007199254740992 },
        { "op": "set", "path": "response.id", "value": 9007199254740992 }
      ],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_typed_outcome" }
    },
    {
      "id": "unknown_raw_field_drops",
      "mutations": [{ "op": "set", "path": "rawResponse", "value": "must-not-pass" }],
      "expected": { "action": "drop", "result": "invalid", "paymentPresent": false, "paymentCredentialParsed": false, "handlerInvoked": false, "applicationOutcome": "not_run", "settlementState": "not_attempted", "reason": "invalid_typed_outcome" }
    }
  ]
}
