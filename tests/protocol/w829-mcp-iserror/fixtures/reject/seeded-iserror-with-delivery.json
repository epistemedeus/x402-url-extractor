      "id": 3,
      "result": {
        "isError": true,
        "content": [
          {
            "type": "text",
            "text": "{\"ok\":true,\"url\":\"https://example.com\",\"title\":\"Example Domain\"}"
          }
        ],
        "structuredContent": {
          "ok": true,
          "url": "https://example.com",
          "requestedUrl": "https://example.com",
          "title": "Example Domain",
          "sourceOk": true
        }
      }
    }
  },
  "claims": {
    "charged": false,
    "paidDelivery": false,
    "successProven": false,
    "settlement": false
  }
