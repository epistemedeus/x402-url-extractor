    "x402Version": 2,
    "scheme": "exact",
    "validity": "EIP-3009 validAfter/validBefore",
    "maxTimeoutSeconds": 300,
    "expiredInvalidReason": "invalid_exact_evm_payload_authorization_valid_before",
    "artifact": "server.js"
  },
  "fixtures": [
    {
      "id": "unpaid-bounded-timeout",
      "path": "pass/unpaid-bounded-timeout.json",
      "expect": "pass",
      "kind": "unpaid-challenge"
    },
    {
      "id": "expired-payload-rejected",
      "path": "pass/expired-payload-rejected.json",
      "expect": "pass",
      "kind": "expired-rejected"
    },
    {
      "id": "expired-replay-layer",
      "path": "pass/expired-replay-layer.json",
      "expect": "pass",
      "kind": "expired-replay-409"
    },
    {
      "id": "not-yet-valid-rejected",
      "path": "pass/not-yet-valid-rejected.json",
      "expect": "pass",
      "kind": "not-yet-valid-rejected"
    },
    {
      "id": "fresh-within-window",
      "path": "pass/fresh-within-window.json",
      "expect": "pass",
      "kind": "fresh-delivery"
    },
    {
      "id": "seeded-expired-accepted",
      "path": "reject/seeded-expired-accepted.json",
