    "x402Version": 2,
    "artifact": "server.js",
    "absentRoute": "/w831-absent-route",
    "declaredPaidRoute": "/extract",
    "declaredFreeRoute": "/healthz",
    "catalogStatus": "route_absent"
  },
  "fixtures": [
    {
      "id": "absent-route-not-402",
      "path": "pass/absent-route-not-402.json",
      "expect": "pass",
      "kind": "http-absent"
    },
    {
      "id": "declared-paid-control",
      "path": "pass/declared-paid-control.json",
      "expect": "pass",
      "kind": "http-paid-control"
    },
    {
      "id": "declared-free-not-absent",
      "path": "pass/declared-free-not-absent.json",
      "expect": "pass",
      "kind": "http-free-surface"
    },
    {
      "id": "catalog-origin-found-route-absent",
      "path": "pass/catalog-origin-found-route-absent.json",
      "expect": "pass",
      "kind": "catalog-route-absent"
    },
    {
      "id": "seeded-absent-route-as-402",
      "path": "reject/seeded-absent-route-as-402.json",
      "expect": "reject",
      "rejectCode": "absent_route_classified_as_402",
      "kind": "seeded-failure"
    },
    {
